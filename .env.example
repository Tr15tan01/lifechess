# Life Chess works with no configuration at all: the game runs in the browser.
# These only matter for optional accounts (saving progress and charts).

# MongoDB connection string, including the database name in the path:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/lifechess?retryWrites=true&w=majority
# Leave as memory://local for a throwaway in-process store (accounts vanish on restart).
DATABASE_URL=memory://local

# Public base URL, used for same-origin checks and secure cookies.
AUTH_URL=http://localhost:3000
